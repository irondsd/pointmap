        <mwm:lang code="en">Colosseum</mwm:lang>
      </mwm:name>
      <mwm:featureTypes>
        <mwm:value>historic-monument</mwm:value>
        <mwm:value>wheelchair-yes</mwm:value>
      </mwm:featureTypes>
      <mwm:scale>17</mwm:scale>
      <mwm:icon>Sights</mwm:icon>
      <mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>
