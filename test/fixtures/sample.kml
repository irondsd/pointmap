    </IconStyle>
  </Style>
  <Style id="placemark-purple">
    <IconStyle>
      <Icon>
        <href>https://omaps.app/placemarks/placemark-purple.png</href>
      </Icon>
    </IconStyle>
  </Style>
  <name>Sample places</name>
  <visibility>1</visibility>
  <ExtendedData xmlns:mwm="https://omaps.app">
    <mwm:name>
      <mwm:lang code="default">Sample places</mwm:lang>
    </mwm:name>
    <mwm:annotation>
    </mwm:annotation>
    <mwm:description>
    </mwm:description>
    <mwm:author id="00000000-0000-0000-0000-000000000000">Example Author</mwm:author>
    <mwm:lastModified>2024-01-01T12:00:00Z</mwm:lastModified>
    <mwm:accessRules>Local</mwm:accessRules>
  </ExtendedData>
  <Placemark>
    <name>Eiffel Tower</name>
    <TimeStamp><when>2024-01-01T10:00:00Z</when></TimeStamp>
    <styleUrl>#placemark-red</styleUrl>
    <Point><coordinates>2.2944813,48.8583701,0</coordinates></Point>
    <ExtendedData xmlns:mwm="https://omaps.app">
      <mwm:name>
        <mwm:lang code="default">Tour Eiffel</mwm:lang>
        <mwm:lang code="en">Eiffel Tower</mwm:lang>
        <mwm:lang code="ja">エッフェル塔</mwm:lang>
        <mwm:lang code="ru">Эйфелева башня</mwm:lang>
      </mwm:name>
      <mwm:customName>
        <mwm:lang code="default">Eiffel Tower</mwm:lang>
      </mwm:customName>
      <mwm:featureTypes>
        <mwm:value>tourism-attraction</mwm:value>
        <mwm:value>building</mwm:value>
        <mwm:value>wheelchair-limited</mwm:value>
      </mwm:featureTypes>
      <mwm:scale>16</mwm:scale>
      <mwm:icon>Sights</mwm:icon>
      <mwm:visibility>1</mwm:visibility>
    </ExtendedData>
  </Placemark>
  <Placemark>
    <name>Colosseum</name>
    <description><![CDATA[<p>Arrive <b>early</b> to skip the queue.</p><script>alert(1)</script>]]></description>
